{
  "manifest_version": 3,
  "name": "Luma Translate",
  "version": "0.32.13",
  "description": "Bilingual web reading, image translation with local OCR, and context-aware video subtitle translation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "src/ui/options.html",
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/reader-config.js",
        "src/image/image-recipe.js",
        "src/image/image-rules.js",
        "src/shared/user-rules.js",
        "src/web/site-rules.js",
        "src/shared/translation-text.js",
        "src/web/paragraph-codec.js",
        "src/shared/reader-ui.js",
        "src/web/content.js",
        "src/image/image-layout.js",
        "src/image/image-content.js",
        "src/video/video-rules.js",
        "src/video/media-core.js",
        "src/video/video-sources.js",
        "src/video/video-reader.js"
      ],
      "css": [
        "src/web/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://*.bilibili.com/*",
        "*://*.wistia.net/*",
        "*://*.wistia.com/*",
        "*://*.ahrefs.com/*"
      ],
      "js": [
        "src/video/video-rules-main.js",
        "src/video/video-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://manga.bilibili.com/*",
        "*://shonenjumpplus.com/*"
      ],
      "js": [
        "src/image/image-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "开启翻译或取消并恢复原文"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "翻译选中文字；未选中时检查并选择段落"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
